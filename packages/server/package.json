{
  "name": "chat-explorer",
  "version": "0.1.0",
  "description": "Explore a Claude Code conversation as a tree of forks in the browser",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "chat-explorer": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "!dist/dev"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "daemon": "node dist/daemon/main.js"
  },
  "dependencies": {
    "@chat-explorer/backend": "workspace:*",
    "@chat-explorer/mcp": "workspace:*",
    "@chat-explorer/runner": "workspace:*",
    "@chat-explorer/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
